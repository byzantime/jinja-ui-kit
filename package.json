{
  "name": "jinja-ui-kit",
  "version": "0.3.0",
  "description": "Build tools for jinja-ui-kit CSS generation",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/styles/input.css -o ./src/jinja_ui_kit/dist/jinja-ui-kit.min.css --minify",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.6"
  }
}
